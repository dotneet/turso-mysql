{
  "version": 1,
  "id": "p0.session-driver-variables",
  "tags": ["p0", "session", "variables"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "the_character_sets_a_driver_reads",
      "session_id": "default",
      "sql": "SELECT @@character_set_client, @@character_set_connection, @@character_set_results, @@character_set_server, @@character_set_database"
    },
    {
      "id": "the_collations_a_driver_reads",
      "session_id": "default",
      "sql": "SELECT @@collation_connection, @@collation_server, @@collation_database"
    },
    {
      "id": "the_zone_the_server_runs_in_and_the_level_it_runs_at",
      "session_id": "default",
      "sql": "SELECT @@system_time_zone, @@transaction_isolation"
    },
    {
      "id": "what_the_counter_steps_by_and_starts_at",
      "session_id": "default",
      "sql": "SELECT @@auto_increment_increment, @@auto_increment_offset"
    },
    {
      "id": "the_rest_of_a_drivers_opening_row",
      "session_id": "default",
      "sql": "SELECT @@performance_schema, @@init_connect, @@license, @@interactive_timeout, @@lower_case_table_names"
    },
    {
      "id": "a_zone_named_as_a_word",
      "session_id": "default",
      "sql": "SET SESSION time_zone = 'utc'"
    },
    {
      "id": "the_word_read_back_upper_cased",
      "session_id": "default",
      "sql": "SELECT @@time_zone"
    },
    {
      "id": "a_zone_named_as_an_offset",
      "session_id": "default",
      "sql": "SET SESSION time_zone = '-00:00'"
    },
    {
      "id": "the_offset_read_back_with_its_sign_settled",
      "session_id": "default",
      "sql": "SELECT @@time_zone"
    },
    {
      "id": "the_global_zone_is_untouched_by_the_session",
      "session_id": "default",
      "sql": "SELECT @@global.time_zone"
    },
    {
      "id": "a_zone_named_as_the_systems",
      "session_id": "default",
      "sql": "SET SESSION time_zone = 'System'"
    },
    {
      "id": "the_systems_zone_read_back_upper_cased",
      "session_id": "default",
      "sql": "SELECT @@time_zone"
    }
  ]
}
