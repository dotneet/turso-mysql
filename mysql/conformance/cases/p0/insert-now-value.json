{
  "version": 1,
  "id": "p0.insert-now-value",
  "tags": ["p0", "insert", "update", "temporal"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_table",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_now_value"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "create_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_now_value (id INT NOT NULL PRIMARY KEY, d DATE, dt DATETIME, ts TIMESTAMP NULL, tm TIME, n BIGINT, label VARCHAR(30)) ENGINE=InnoDB"
    },
    {
      "id": "insert_today_and_this_moment",
      "session_id": "default",
      "sql": "INSERT INTO p0_now_value (id, d, dt) VALUES (1, CURDATE(), NOW())"
    },
    {
      "id": "insert_a_day_into_a_moment",
      "session_id": "default",
      "sql": "INSERT INTO p0_now_value (id, d, dt) VALUES (2, CURDATE(), CURDATE())"
    },
    {
      "id": "insert_a_stamp_and_a_time_of_day",
      "session_id": "default",
      "sql": "INSERT INTO p0_now_value (id, ts, tm) VALUES (3, NOW(), CURTIME())"
    },
    {
      "id": "insert_a_moment_into_a_number_and_a_word",
      "session_id": "default",
      "sql": "INSERT INTO p0_now_value (id, n, label) VALUES (4, NOW(), NOW())"
    },
    {
      "id": "the_day_written_by_curdate_is_today",
      "session_id": "default",
      "sql": "SELECT id FROM p0_now_value WHERE d = CURDATE() ORDER BY id"
    },
    {
      "id": "the_moment_written_by_curdate_is_this_mornings_midnight",
      "session_id": "default",
      "sql": "SELECT id FROM p0_now_value WHERE dt = CURDATE() ORDER BY id"
    },
    {
      "id": "the_stamp_written_by_now_is_not_in_the_future",
      "session_id": "default",
      "sql": "SELECT id FROM p0_now_value WHERE ts <= NOW() ORDER BY id"
    },
    {
      "id": "the_word_written_by_now_is_the_moment_written_out",
      "session_id": "default",
      "sql": "SELECT CHAR_LENGTH(label) FROM p0_now_value WHERE id = 4"
    },
    {
      "id": "the_number_written_by_now_is_the_moment_run_together",
      "session_id": "default",
      "sql": "SELECT n > 20000000000000 FROM p0_now_value WHERE id = 4"
    },
    {
      "id": "update_a_moment_to_now",
      "session_id": "default",
      "sql": "UPDATE p0_now_value SET dt = NOW() WHERE id = 2"
    },
    {
      "id": "the_updated_moment_is_no_longer_midnight",
      "session_id": "default",
      "sql": "SELECT id FROM p0_now_value WHERE dt = CURDATE() ORDER BY id"
    },
    {
      "id": "cleanup_table",
      "session_id": "default",
      "sql": "DROP TABLE p0_now_value"
    }
  ]
}
