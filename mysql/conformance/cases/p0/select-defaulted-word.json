{
  "version": 1,
  "id": "p0.select-defaulted-word",
  "tags": ["p0", "select", "ifnull"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_table",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_defaulted_word"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "create_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_defaulted_word (id INT NOT NULL PRIMARY KEY, email VARCHAR(80), name VARCHAR(40) NOT NULL, ch CHAR(5)) ENGINE=InnoDB"
    },
    {
      "id": "insert_rows",
      "session_id": "default",
      "sql": "INSERT INTO p0_defaulted_word (id, email, name, ch) VALUES (1, NULL, 'ada', NULL), (2, 'g@x.io', 'grace', 'abc')"
    },
    {
      "id": "a_word_to_fall_back_on",
      "session_id": "default",
      "sql": "SELECT IFNULL(email, 'none') AS defaulted FROM p0_defaulted_word ORDER BY id"
    },
    {
      "id": "the_other_spelling_of_the_same_call",
      "session_id": "default",
      "sql": "SELECT COALESCE(email, 'none') AS defaulted FROM p0_defaulted_word ORDER BY id"
    },
    {
      "id": "a_shorter_word_to_fall_back_on",
      "session_id": "default",
      "sql": "SELECT IFNULL(email, 'x') AS defaulted FROM p0_defaulted_word ORDER BY id"
    },
    {
      "id": "a_column_that_can_never_be_null",
      "session_id": "default",
      "sql": "SELECT IFNULL(name, 'none') AS defaulted FROM p0_defaulted_word ORDER BY id"
    },
    {
      "id": "a_column_of_fixed_width",
      "session_id": "default",
      "sql": "SELECT IFNULL(ch, 'none') AS defaulted FROM p0_defaulted_word ORDER BY id"
    },
    {
      "id": "cleanup_table",
      "session_id": "default",
      "sql": "DROP TABLE p0_defaulted_word"
    }
  ]
}
