{
  "version": 1,
  "id": "p0.select-regexp",
  "tags": [
    "p0",
    "select",
    "where",
    "regexp"
  ],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {
        "kind": "utc"
      },
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_table",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_regexp"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "create_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_regexp (id INT NOT NULL PRIMARY KEY, name VARCHAR(30), n INT) ENGINE=InnoDB"
    },
    {
      "id": "insert_rows",
      "session_id": "default",
      "sql": "INSERT INTO p0_regexp (id, name, n) VALUES (1, 'Alpha', 5), (2, 'beta', 3), (3, 'cafe', 9), (4, 'a1b', 2), (5, NULL, 7)"
    },
    {
      "id": "a_pattern_ignoring_case",
      "session_id": "default",
      "sql": "SELECT id FROM p0_regexp WHERE name REGEXP 'alpha' ORDER BY id"
    },
    {
      "id": "the_rlike_spelling",
      "session_id": "default",
      "sql": "SELECT id FROM p0_regexp WHERE name RLIKE 'ALPHA' ORDER BY id"
    },
    {
      "id": "a_pattern_anchored_at_the_front",
      "session_id": "default",
      "sql": "SELECT id FROM p0_regexp WHERE name REGEXP '^a' ORDER BY id"
    },
    {
      "id": "a_pattern_anchored_at_the_end",
      "session_id": "default",
      "sql": "SELECT id FROM p0_regexp WHERE name REGEXP 'a$' ORDER BY id"
    },
    {
      "id": "a_pattern_naming_a_character_class",
      "session_id": "default",
      "sql": "SELECT id FROM p0_regexp WHERE name REGEXP '[[:digit:]]' ORDER BY id"
    },
    {
      "id": "a_pattern_that_repeats",
      "session_id": "default",
      "sql": "SELECT id FROM p0_regexp WHERE name REGEXP 'a{1,2}' ORDER BY id"
    },
    {
      "id": "a_pattern_of_two_choices",
      "session_id": "default",
      "sql": "SELECT id FROM p0_regexp WHERE name REGEXP 'alpha|beta' ORDER BY id"
    },
    {
      "id": "a_pattern_negated",
      "session_id": "default",
      "sql": "SELECT id FROM p0_regexp WHERE name NOT REGEXP 'a' ORDER BY id"
    },
    {
      "id": "a_pattern_with_any_character",
      "session_id": "default",
      "sql": "SELECT id FROM p0_regexp WHERE name REGEXP 'caf.' ORDER BY id"
    },
    {
      "id": "a_pattern_looking_ahead",
      "session_id": "default",
      "sql": "SELECT id FROM p0_regexp WHERE name REGEXP 'a(?=1)' ORDER BY id"
    },
    {
      "id": "a_pattern_over_a_number",
      "session_id": "default",
      "sql": "SELECT id FROM p0_regexp WHERE n REGEXP '5' ORDER BY id"
    },
    {
      "id": "a_pattern_ignoring_accents",
      "session_id": "default",
      "sql": "SELECT 'café' REGEXP 'cafe' AS accent_folded, 'Alpha' REGEXP 'alpha' AS case_folded"
    },
    {
      "id": "cleanup_table",
      "session_id": "default",
      "sql": "DROP TABLE p0_regexp"
    }
  ]
}
