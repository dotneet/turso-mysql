{
  "version": 1,
  "id": "p0.select-having-without-group-by",
  "tags": ["p0", "select", "having"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_table",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_having"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "create_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_having (id INT NOT NULL PRIMARY KEY, n INT, name VARCHAR(10)) ENGINE=InnoDB"
    },
    {
      "id": "insert_rows",
      "session_id": "default",
      "sql": "INSERT INTO p0_having (id, n, name) VALUES (1, 5, 'a'), (2, 3, 'b'), (3, 9, 'c'), (4, NULL, 'd')"
    },
    {
      "id": "a_having_over_a_column",
      "session_id": "default",
      "sql": "SELECT id FROM p0_having HAVING id > 1 ORDER BY id"
    },
    {
      "id": "a_having_over_a_column_that_is_not_projected",
      "session_id": "default",
      "sql": "SELECT id FROM p0_having HAVING n > 4 ORDER BY id"
    },
    {
      "id": "a_having_beside_a_where",
      "session_id": "default",
      "sql": "SELECT id FROM p0_having WHERE id > 1 HAVING n > 4 ORDER BY id"
    },
    {
      "id": "a_having_over_a_word",
      "session_id": "default",
      "sql": "SELECT id FROM p0_having HAVING name = 'B' ORDER BY id"
    },
    {
      "id": "a_having_over_nothing",
      "session_id": "default",
      "sql": "SELECT id FROM p0_having HAVING n IS NULL ORDER BY id"
    },
    {
      "id": "cleanup_table",
      "session_id": "default",
      "sql": "DROP TABLE p0_having"
    }
  ]
}
