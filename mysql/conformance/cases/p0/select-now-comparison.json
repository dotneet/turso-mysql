{
  "version": 1,
  "id": "p0.select-now-comparison",
  "tags": ["p0", "select", "comparison", "temporal"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_table",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_now_compare"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "create_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_now_compare (id INT NOT NULL PRIMARY KEY, d DATE, dt DATETIME) ENGINE=InnoDB"
    },
    {
      "id": "insert_today_and_long_ago",
      "session_id": "default",
      "sql": "INSERT INTO p0_now_compare (id, d, dt) VALUES (1, CURDATE(), NOW()), (2, '2000-01-01', '2000-01-01 00:00:00')"
    },
    {
      "id": "date_is_today",
      "session_id": "default",
      "sql": "SELECT id FROM p0_now_compare WHERE d = CURDATE() ORDER BY id"
    },
    {
      "id": "date_is_before_today",
      "session_id": "default",
      "sql": "SELECT id FROM p0_now_compare WHERE d < CURDATE() ORDER BY id"
    },
    {
      "id": "date_is_today_or_later",
      "session_id": "default",
      "sql": "SELECT id FROM p0_now_compare WHERE d >= CURRENT_DATE ORDER BY id"
    },
    {
      "id": "moment_is_not_in_the_future",
      "session_id": "default",
      "sql": "SELECT id FROM p0_now_compare WHERE dt <= NOW() ORDER BY id"
    },
    {
      "id": "moment_is_in_the_future",
      "session_id": "default",
      "sql": "SELECT id FROM p0_now_compare WHERE dt > CURRENT_TIMESTAMP ORDER BY id"
    },
    {
      "id": "moment_compared_to_today",
      "session_id": "default",
      "sql": "SELECT id FROM p0_now_compare WHERE dt = CURDATE() ORDER BY id"
    },
    {
      "id": "cleanup_table",
      "session_id": "default",
      "sql": "DROP TABLE p0_now_compare"
    }
  ]
}
