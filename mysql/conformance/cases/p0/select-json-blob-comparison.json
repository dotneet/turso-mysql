{
  "version": 1,
  "id": "p0.select-json-blob-comparison",
  "tags": ["p0", "select", "comparison", "json", "blob"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_table",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_json_blob"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "create_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_json_blob (id INT NOT NULL PRIMARY KEY, doc JSON, payload BLOB) ENGINE=InnoDB"
    },
    {
      "id": "insert_rows",
      "session_id": "default",
      "sql": "INSERT INTO p0_json_blob (id, doc, payload) VALUES (1, '{\"b\": 2, \"a\": 1}', 'abc'), (2, '[1, 2]', 'x'), (3, '\"word\"', '')"
    },
    {
      "id": "the_documents_as_stored",
      "session_id": "default",
      "sql": "SELECT id, doc FROM p0_json_blob ORDER BY id"
    },
    {
      "id": "a_document_written_the_way_it_is_stored",
      "session_id": "default",
      "sql": "SELECT id FROM p0_json_blob WHERE doc = '{\"a\": 1, \"b\": 2}' ORDER BY id"
    },
    {
      "id": "a_document_written_another_way",
      "session_id": "default",
      "sql": "SELECT id FROM p0_json_blob WHERE doc = '{\"b\":2,\"a\":1}' ORDER BY id"
    },
    {
      "id": "a_document_that_is_a_word",
      "session_id": "default",
      "sql": "SELECT id FROM p0_json_blob WHERE doc = '\"word\"' ORDER BY id"
    },
    {
      "id": "a_document_compared_to_a_bare_word",
      "session_id": "default",
      "sql": "SELECT id FROM p0_json_blob WHERE doc = 'word' ORDER BY id"
    },
    {
      "id": "an_array_read_in_order",
      "session_id": "default",
      "sql": "SELECT id FROM p0_json_blob WHERE doc > '[1, 1]' ORDER BY id"
    },
    {
      "id": "bytes_that_match",
      "session_id": "default",
      "sql": "SELECT id FROM p0_json_blob WHERE payload = 'abc' ORDER BY id"
    },
    {
      "id": "bytes_that_differ_by_case",
      "session_id": "default",
      "sql": "SELECT id FROM p0_json_blob WHERE payload = 'ABC' ORDER BY id"
    },
    {
      "id": "bytes_read_in_order",
      "session_id": "default",
      "sql": "SELECT id FROM p0_json_blob WHERE payload > 'a' ORDER BY id"
    },
    {
      "id": "cleanup_table",
      "session_id": "default",
      "sql": "DROP TABLE p0_json_blob"
    }
  ]
}
