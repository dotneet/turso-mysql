{
  "version": 1,
  "id": "p0.create-column-comment",
  "tags": ["p0", "ddl", "catalog"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_noted",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_noted"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "a_table_whose_columns_say_what_they_hold",
      "session_id": "default",
      "sql": "CREATE TABLE p0_noted (id INT NOT NULL AUTO_INCREMENT COMMENT 'the id', name VARCHAR(40) COMMENT '名前', quoted INT COMMENT 'it''s here', plain INT, unlabelled INT COMMENT '', PRIMARY KEY (id)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4"
    },
    {
      "id": "what_the_table_carries",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_noted"
    },
    {
      "id": "the_columns_it_reports",
      "session_id": "default",
      "sql": "SHOW COLUMNS FROM p0_noted"
    },
    {
      "id": "the_columns_it_reports_in_full",
      "session_id": "default",
      "sql": "SHOW FULL COLUMNS FROM p0_noted"
    },
    {
      "id": "what_the_catalog_reports",
      "session_id": "default",
      "sql": "SELECT COLUMN_NAME, COLUMN_COMMENT FROM information_schema.COLUMNS WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'p0_noted' ORDER BY ORDINAL_POSITION"
    },
    {
      "id": "cleanup_noted",
      "session_id": "default",
      "sql": "DROP TABLE p0_noted"
    }
  ]
}
