    {
      "id": "a_table_writing_its_key_as_a_clause",
      "session_id": "default",
      "sql": "CREATE TABLE p0_written_key (id INT NOT NULL, n INT, PRIMARY KEY (id)) ENGINE=InnoDB"
    },
