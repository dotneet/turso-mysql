      "sql": "SHOW CREATE TABLE p0_written_key"
    },
    {
      "id": "rows_written_through_the_key",
      "session_id": "default",
      "sql": "INSERT INTO p0_written_key (id, n) VALUES (2, 20), (1, 10)"
    },
    {
      "id": "the_rows_read_back",
      "session_id": "default",
      "sql": "SELECT id, n FROM p0_written_key ORDER BY id"
    },
    {
      "id": "a_key_over_a_column_written_nullable",
      "session_id": "default",
      "sql": "CREATE TABLE p0_key_over_nullable (id INT NOT NULL, n INT, PRIMARY KEY (n)) ENGINE=InnoDB"
    },
    {
      "id": "what_the_key_over_a_nullable_column_carries",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_key_over_nullable"
    },
    {
      "id": "a_key_written_with_a_constraint_name",
      "session_id": "default",
      "sql": "CREATE TABLE p0_named_key (id INT NOT NULL, n INT, CONSTRAINT pk_of_rows PRIMARY KEY (ID)) ENGINE=InnoDB"
    },
    {
      "id": "what_the_named_key_carries",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_named_key"
