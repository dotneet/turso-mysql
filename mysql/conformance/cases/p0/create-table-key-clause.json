    {
      "id": "a_key_written_beside_an_index",
      "session_id": "default",
      "sql": "CREATE TABLE p0_key_beside_index (id INT NOT NULL, n INT, PRIMARY KEY (id), KEY idx_n (n)) ENGINE=InnoDB"
    },
    {
      "id": "what_the_key_beside_an_index_carries",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_key_beside_index"
    },
    {
      "id": "cleanup_written_key",
