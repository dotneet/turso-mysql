{
  "version": 1,
  "id": "p0.select-like-concat-pattern",
  "tags": ["p0", "select", "like", "concat"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_table",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_like_concat"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "create_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_like_concat (id INT NOT NULL PRIMARY KEY, name VARCHAR(20)) ENGINE=InnoDB"
    },
    {
      "id": "insert_rows",
      "session_id": "default",
      "sql": "INSERT INTO p0_like_concat (id, name) VALUES (1, 'alpha'), (2, 'beta'), (3, 'ALPHABET'), (4, 'gamma')"
    },
    {
      "id": "a_pattern_built_in_pieces",
      "session_id": "default",
      "sql": "SELECT id FROM p0_like_concat WHERE name LIKE CONCAT('%', 'lph', '%') ORDER BY id"
    },
    {
      "id": "the_same_pattern_written_out",
      "session_id": "default",
      "sql": "SELECT id FROM p0_like_concat WHERE name LIKE '%lph%' ORDER BY id"
    },
    {
      "id": "a_pattern_anchored_at_the_front",
      "session_id": "default",
      "sql": "SELECT id FROM p0_like_concat WHERE name LIKE CONCAT('al', '%') ORDER BY id"
    },
    {
      "id": "a_pattern_of_two_pieces_with_no_wildcard",
      "session_id": "default",
      "sql": "SELECT id FROM p0_like_concat WHERE name LIKE CONCAT('al', 'pha') ORDER BY id"
    },
    {
      "id": "a_negated_pattern_built_in_pieces",
      "session_id": "default",
      "sql": "SELECT id FROM p0_like_concat WHERE name NOT LIKE CONCAT('%', 'lph', '%') ORDER BY id"
    },
    {
      "id": "a_pattern_holding_nothing",
      "session_id": "default",
      "sql": "SELECT id FROM p0_like_concat WHERE name LIKE CONCAT('%', NULL, '%') ORDER BY id"
    },
    {
      "id": "a_delete_over_a_pattern_built_in_pieces",
      "session_id": "default",
      "sql": "DELETE FROM p0_like_concat WHERE name LIKE CONCAT('gam', '%')"
    },
    {
      "id": "the_rows_after_the_delete",
      "session_id": "default",
      "sql": "SELECT id, name FROM p0_like_concat ORDER BY id"
    },
    {
      "id": "cleanup_table",
      "session_id": "default",
      "sql": "DROP TABLE p0_like_concat"
    }
  ]
}
