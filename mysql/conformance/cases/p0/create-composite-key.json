    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_joined",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_composite_key"
    },
    {
      "id": "drop_indexed",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_composite_key_indexed"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "the_join_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_composite_key (a INT NOT NULL, b INT NOT NULL, n INT, PRIMARY KEY (a, b)) ENGINE=InnoDB"
    },
    {
      "id": "what_the_join_table_carries",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_composite_key"
    },
    {
      "id": "the_columns_it_reports",
      "session_id": "default",
      "sql": "SHOW COLUMNS FROM p0_composite_key"
    },
    {
      "id": "two_rows_under_the_key",
      "session_id": "default",
      "sql": "INSERT INTO p0_composite_key (a, b, n) VALUES (1, 1, 10), (1, 2, 20)"
    },
    {
      "id": "a_row_repeating_the_key",
      "session_id": "default",
      "sql": "INSERT INTO p0_composite_key (a, b, n) VALUES (1, 1, 30)"
    },
    {
      "id": "the_rows_read_back",
      "session_id": "default",
      "sql": "SELECT a, b, n FROM p0_composite_key ORDER BY a, b"
    },
    {
      "id": "a_column_added_to_the_join_table",
      "session_id": "default",
      "sql": "ALTER TABLE p0_composite_key ADD COLUMN extra VARCHAR(5)"
    },
    {
      "id": "what_the_join_table_carries_after_adding",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_composite_key"
    },
    {
      "id": "a_join_table_carrying_an_index_as_well",
      "session_id": "default",
      "sql": "CREATE TABLE p0_composite_key_indexed (a INT NOT NULL, b INT NOT NULL, PRIMARY KEY (a, b), KEY idx_p0_b (b)) ENGINE=InnoDB"
    },
    {
      "id": "what_the_indexed_join_table_carries",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_composite_key_indexed"
    },
    {
      "id": "cleanup_joined",
      "session_id": "default",
      "sql": "DROP TABLE p0_composite_key"
    },
    {
      "id": "cleanup_indexed",
      "session_id": "default",
      "sql": "DROP TABLE p0_composite_key_indexed"
    }
  ]
