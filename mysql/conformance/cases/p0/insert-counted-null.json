    },
    {
      "id": "a_counted_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_asked (id INT NOT NULL AUTO_INCREMENT, n INT, PRIMARY KEY (id)) ENGINE=InnoDB"
    },
    {
      "id": "a_row_writing_null",
      "session_id": "default",
      "sql": "INSERT INTO p0_asked (id, n) VALUES (NULL, 1)"
    },
    {
      "id": "what_the_null_row_took",
      "session_id": "default",
      "sql": "SELECT LAST_INSERT_ID()"
    },
    {
      "id": "a_row_writing_zero",
      "session_id": "default",
      "sql": "INSERT INTO p0_asked (id, n) VALUES (0, 2)"
    },
    {
      "id": "what_the_zero_row_took",
      "session_id": "default",
      "sql": "SELECT LAST_INSERT_ID()"
    },
    {
      "id": "rows_that_all_ask",
      "session_id": "default",
      "sql": "INSERT INTO p0_asked (id, n) VALUES (NULL, 3), (0, 4)"
    },
    {
      "id": "what_the_first_of_them_took",
      "session_id": "default",
      "sql": "SELECT LAST_INSERT_ID()"
    },
    {
      "id": "the_rows_as_written",
      "session_id": "default",
      "sql": "SELECT id, n FROM p0_asked ORDER BY id"
    },
    {
      "id": "the_counter_as_it_stands",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_asked"
    },
    {
