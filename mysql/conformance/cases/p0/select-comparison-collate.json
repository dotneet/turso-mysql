{
  "version": 1,
  "id": "p0.select-comparison-collate",
  "tags": ["p0", "select", "where", "collation"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_table",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_compare_collate"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "create_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_compare_collate (id INT NOT NULL PRIMARY KEY, name VARCHAR(20)) ENGINE=InnoDB"
    },
    {
      "id": "insert_rows",
      "session_id": "default",
      "sql": "INSERT INTO p0_compare_collate (id, name) VALUES (1, 'alpha'), (2, 'Alpha'), (3, 'ALPHA'), (4, 'beta')"
    },
    {
      "id": "a_comparison_with_no_collation_named",
      "session_id": "default",
      "sql": "SELECT id FROM p0_compare_collate WHERE name = 'alpha' ORDER BY id"
    },
    {
      "id": "a_comparison_by_bytes_on_the_value",
      "session_id": "default",
      "sql": "SELECT id FROM p0_compare_collate WHERE name = 'alpha' COLLATE utf8mb4_bin ORDER BY id"
    },
    {
      "id": "a_comparison_by_bytes_on_the_column",
      "session_id": "default",
      "sql": "SELECT id FROM p0_compare_collate WHERE name COLLATE utf8mb4_bin = 'alpha' ORDER BY id"
    },
    {
      "id": "a_comparison_by_the_default_collation",
      "session_id": "default",
      "sql": "SELECT id FROM p0_compare_collate WHERE name = 'alpha' COLLATE utf8mb4_0900_ai_ci ORDER BY id"
    },
    {
      "id": "an_inequality_by_bytes",
      "session_id": "default",
      "sql": "SELECT id FROM p0_compare_collate WHERE name <> 'alpha' COLLATE utf8mb4_bin ORDER BY id"
    },
    {
      "id": "an_ordering_comparison_by_bytes",
      "session_id": "default",
      "sql": "SELECT id FROM p0_compare_collate WHERE name < 'alpha' COLLATE utf8mb4_bin ORDER BY id"
    },
    {
      "id": "a_pattern_by_bytes",
      "session_id": "default",
      "sql": "SELECT id FROM p0_compare_collate WHERE name LIKE 'alpha' COLLATE utf8mb4_bin ORDER BY id"
    },
    {
      "id": "a_membership_by_bytes",
      "session_id": "default",
      "sql": "SELECT id FROM p0_compare_collate WHERE name IN ('alpha' COLLATE utf8mb4_bin) ORDER BY id"
    },
    {
      "id": "a_collation_over_a_number",
      "session_id": "default",
      "sql": "SELECT id FROM p0_compare_collate WHERE id = 1 COLLATE utf8mb4_bin ORDER BY id"
    },
    {
      "id": "cleanup_table",
      "session_id": "default",
      "sql": "DROP TABLE p0_compare_collate"
    }
  ]
}
