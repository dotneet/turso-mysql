{
  "version": 1,
  "id": "p0.select-defaulted-aggregate",
  "tags": ["p0", "select", "aggregate", "ifnull"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_table",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_defaulted"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "create_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_defaulted (id INT NOT NULL PRIMARY KEY, n INT, s SMALLINT, amount DECIMAL(10,2), name VARCHAR(20)) ENGINE=InnoDB"
    },
    {
      "id": "insert_rows",
      "session_id": "default",
      "sql": "INSERT INTO p0_defaulted (id, n, s, amount, name) VALUES (1, 5, 2, 1.50, 'a'), (2, 3, 4, 2.25, 'b'), (3, 9, 6, 3.00, 'c')"
    },
    {
      "id": "a_defaulted_sum",
      "session_id": "default",
      "sql": "SELECT IFNULL(SUM(n), 0) FROM p0_defaulted"
    },
    {
      "id": "a_defaulted_max",
      "session_id": "default",
      "sql": "SELECT COALESCE(MAX(n), 0) FROM p0_defaulted"
    },
    {
      "id": "a_defaulted_count",
      "session_id": "default",
      "sql": "SELECT IFNULL(COUNT(*), 0) FROM p0_defaulted"
    },
    {
      "id": "a_defaulted_average",
      "session_id": "default",
      "sql": "SELECT IFNULL(AVG(n), 0) FROM p0_defaulted"
    },
    {
      "id": "a_defaulted_sum_over_a_decimal",
      "session_id": "default",
      "sql": "SELECT IFNULL(SUM(amount), 0) FROM p0_defaulted"
    },
    {
      "id": "a_defaulted_max_over_a_smallint",
      "session_id": "default",
      "sql": "SELECT IFNULL(MAX(s), 0) FROM p0_defaulted"
    },
    {
      "id": "a_defaulted_sum_over_no_rows",
      "session_id": "default",
      "sql": "SELECT IFNULL(SUM(n), 0) FROM p0_defaulted WHERE id > 100"
    },
    {
      "id": "a_defaulted_sum_under_an_alias",
      "session_id": "default",
      "sql": "SELECT IFNULL(SUM(n), 0) AS total FROM p0_defaulted"
    },
    {
      "id": "a_defaulted_sum_beside_a_grouping_column",
      "session_id": "default",
      "sql": "SELECT name, IFNULL(SUM(n), 0) FROM p0_defaulted GROUP BY name ORDER BY name"
    },
    {
      "id": "a_defaulted_sum_beside_an_ungrouped_column",
      "session_id": "default",
      "sql": "SELECT id, IFNULL(SUM(n), 0) FROM p0_defaulted"
    },
    {
      "id": "cleanup_table",
      "session_id": "default",
      "sql": "DROP TABLE p0_defaulted"
    }
  ]
}
