{
  "version": 1,
  "id": "p0.select-prepared-json",
  "tags": ["p0", "select", "json"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_documents",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_prepared_json"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "a_table_holding_a_document",
      "session_id": "default",
      "sql": "CREATE TABLE p0_prepared_json (id INT NOT NULL, doc JSON, PRIMARY KEY (id)) ENGINE=InnoDB"
    },
    {
      "id": "a_row_with_a_document",
      "session_id": "default",
      "sql": "INSERT INTO p0_prepared_json (id, doc) VALUES (1, '{\"k\": 1}'), (2, NULL)"
    },
    {
      "id": "the_document_read_over_the_text_protocol",
      "session_id": "default",
      "sql": "SELECT id, doc FROM p0_prepared_json ORDER BY id"
    },
    {
      "id": "the_document_read_with_a_bound_value",
      "session_id": "default",
      "sql": "SELECT id, doc FROM p0_prepared_json WHERE id = ?",
      "params": [
        {
          "type": "signed_int",
          "value": 1
        }
      ]
    },
    {
      "id": "the_null_document_read_with_a_bound_value",
      "session_id": "default",
      "sql": "SELECT id, doc FROM p0_prepared_json WHERE id = ?",
      "params": [
        {
          "type": "signed_int",
          "value": 2
        }
      ]
    },
    {
      "id": "cleanup_documents",
      "session_id": "default",
      "sql": "DROP TABLE p0_prepared_json"
    }
  ]
}
