    {
      "id": "the_statement_an_orm_writes",
      "session_id": "default",
      "sql": "CREATE TABLE `p0_bigint_counter` (\n  `id` bigint NOT NULL AUTO_INCREMENT,\n  `n` int DEFAULT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci"
    },
    {
      "id": "what_the_wide_counted_table_carries",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_bigint_counter"
    },
    {
      "id": "the_columns_it_reports",
      "session_id": "default",
      "sql": "SHOW COLUMNS FROM p0_bigint_counter"
    },
    {
      "id": "a_counted_row",
      "session_id": "default",
      "sql": "INSERT INTO p0_bigint_counter (n) VALUES (1)"
    },
    {
      "id": "another_counted_row",
      "session_id": "default",
      "sql": "INSERT INTO p0_bigint_counter (n) VALUES (2)"
    },
    {
      "id": "a_row_written_past_what_an_int_holds",
      "session_id": "default",
      "sql": "INSERT INTO p0_bigint_counter (id, n) VALUES (9000000000, 3)"
    },
    {
      "id": "the_counter_carries_on_past_it",
      "session_id": "default",
      "sql": "INSERT INTO p0_bigint_counter (n) VALUES (4)"
    },
    {
      "id": "the_rows_read_back",
      "session_id": "default",
      "sql": "SELECT id, n FROM p0_bigint_counter ORDER BY id"
    },
    {
      "id": "what_the_table_carries_after_counting",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_bigint_counter"
    },
    {
      "id": "cleanup_wide",
      "session_id": "default",
      "sql": "DROP TABLE p0_bigint_counter"
    }
  ]
