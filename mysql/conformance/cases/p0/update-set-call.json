{
  "version": 1,
  "id": "p0.update-set-call",
  "tags": ["p0", "update", "function"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_table",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_set_call"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "create_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_set_call (id INT NOT NULL PRIMARY KEY, n INT, name VARCHAR(30)) ENGINE=InnoDB"
    },
    {
      "id": "insert_rows",
      "session_id": "default",
      "sql": "INSERT INTO p0_set_call (id, n, name) VALUES (1, 5, ' Alpha '), (2, NULL, 'beta')"
    },
    {
      "id": "a_word_joined_to_itself",
      "session_id": "default",
      "sql": "UPDATE p0_set_call SET name = CONCAT(name, 'x') WHERE id = 2"
    },
    {
      "id": "a_word_in_lower_case",
      "session_id": "default",
      "sql": "UPDATE p0_set_call SET name = LOWER(name) WHERE id = 1"
    },
    {
      "id": "a_word_trimmed",
      "session_id": "default",
      "sql": "UPDATE p0_set_call SET name = TRIM(name) WHERE id = 1"
    },
    {
      "id": "a_number_with_a_fallback",
      "session_id": "default",
      "sql": "UPDATE p0_set_call SET n = IFNULL(n, 0) WHERE id = 2"
    },
    {
      "id": "a_number_counted_from_a_word",
      "session_id": "default",
      "sql": "UPDATE p0_set_call SET n = CHAR_LENGTH(name) WHERE id = 2"
    },
    {
      "id": "a_word_chosen_by_a_case",
      "session_id": "default",
      "sql": "UPDATE p0_set_call SET name = CASE WHEN n > 1 THEN 'big' ELSE 'small' END WHERE id = 1"
    },
    {
      "id": "a_word_cut_short",
      "session_id": "default",
      "sql": "UPDATE p0_set_call SET name = SUBSTRING(name, 1, 3) WHERE id = 2"
    },
    {
      "id": "a_call_beside_a_written_value",
      "session_id": "default",
      "sql": "UPDATE p0_set_call SET n = 1, name = CONCAT(name, 'y') WHERE id = 2"
    },
    {
      "id": "a_call_before_a_written_value",
      "session_id": "default",
      "sql": "UPDATE p0_set_call SET name = CONCAT(name, 'z'), n = 2 WHERE id = 2"
    },
    {
      "id": "the_rows_after_the_writes",
      "session_id": "default",
      "sql": "SELECT id, n, name FROM p0_set_call ORDER BY id"
    },
    {
      "id": "a_call_reading_a_column_already_written",
      "session_id": "default",
      "sql": "UPDATE p0_set_call SET name = 'q', n = CHAR_LENGTH(name) WHERE id = 2"
    },
    {
      "id": "the_rows_after_that",
      "session_id": "default",
      "sql": "SELECT id, n, name FROM p0_set_call ORDER BY id"
    },
    {
      "id": "cleanup_table",
      "session_id": "default",
      "sql": "DROP TABLE p0_set_call"
    }
  ]
}
