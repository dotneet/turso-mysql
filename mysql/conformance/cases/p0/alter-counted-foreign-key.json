{
  "version": 1,
  "id": "p0.alter-counted-foreign-key",
  "tags": ["p0", "alter", "foreign-key"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_child",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_fk_books"
    },
    {
      "id": "drop_parent",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_fk_authors"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "the_parent_table_a_migration_writes",
      "session_id": "default",
      "sql": "CREATE TABLE p0_fk_authors (id BIGINT NOT NULL AUTO_INCREMENT, name VARCHAR(120) NOT NULL, PRIMARY KEY (id)) ENGINE=InnoDB"
    },
    {
      "id": "the_child_table_a_migration_writes",
      "session_id": "default",
      "sql": "CREATE TABLE p0_fk_books (id BIGINT NOT NULL AUTO_INCREMENT, author_id BIGINT NOT NULL, PRIMARY KEY (id), KEY index_books_on_author_id (author_id)) ENGINE=InnoDB"
    },
    {
      "id": "the_key_added_afterwards_the_way_a_migration_adds_it",
      "session_id": "default",
      "sql": "ALTER TABLE p0_fk_books ADD CONSTRAINT fk_books_author FOREIGN KEY (author_id) REFERENCES p0_fk_authors (id) ON DELETE CASCADE"
    },
    {
      "id": "how_the_child_reads_back_with_the_key",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_fk_books"
    },
    {
      "id": "an_author",
      "session_id": "default",
      "sql": "INSERT INTO p0_fk_authors (name) VALUES ('Ada')"
    },
    {
      "id": "a_book_naming_that_author",
      "session_id": "default",
      "sql": "INSERT INTO p0_fk_books (author_id) VALUES (1)"
    },
    {
      "id": "a_book_naming_an_author_that_is_not_there",
      "session_id": "default",
      "sql": "INSERT INTO p0_fk_books (author_id) VALUES (99)"
    },
    {
      "id": "the_author_taken_away",
      "session_id": "default",
      "sql": "DELETE FROM p0_fk_authors WHERE id = 1"
    },
    {
      "id": "what_is_left_of_the_books",
      "session_id": "default",
      "sql": "SELECT COUNT(*) FROM p0_fk_books"
    },
    {
      "id": "the_key_taken_off_again",
      "session_id": "default",
      "sql": "ALTER TABLE p0_fk_books DROP FOREIGN KEY fk_books_author"
    },
    {
      "id": "how_the_child_reads_back_without_the_key",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_fk_books"
    },
    {
      "id": "a_book_naming_no_author_once_the_key_is_gone",
      "session_id": "default",
      "sql": "INSERT INTO p0_fk_books (author_id) VALUES (99)"
    },
    {
      "id": "cleanup_child",
      "session_id": "default",
      "sql": "DROP TABLE p0_fk_books"
    },
    {
      "id": "cleanup_parent",
      "session_id": "default",
      "sql": "DROP TABLE p0_fk_authors"
    }
  ]
}
