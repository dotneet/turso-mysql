{
  "version": 1,
  "id": "p0.create-counted-key-clause",
  "tags": ["p0", "ddl", "auto_increment"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_dumped",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_counted_dumped"
    },
    {
      "id": "drop_beside_an_index",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_counted_beside_index"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "the_statement_a_dump_carries",
      "session_id": "default",
      "sql": "CREATE TABLE `p0_counted_dumped` (\n  `id` int NOT NULL AUTO_INCREMENT,\n  `n` int DEFAULT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci"
    },
    {
      "id": "what_the_dumped_table_carries",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_counted_dumped"
    },
    {
      "id": "two_rows_counted",
      "session_id": "default",
      "sql": "INSERT INTO p0_counted_dumped (n) VALUES (1)"
    },
    {
      "id": "another_row_counted",
      "session_id": "default",
      "sql": "INSERT INTO p0_counted_dumped (n) VALUES (2)"
    },
    {
      "id": "the_rows_read_back",
      "session_id": "default",
      "sql": "SELECT id, n FROM p0_counted_dumped ORDER BY id"
    },
    {
      "id": "what_the_dumped_table_carries_after_counting",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_counted_dumped"
    },
    {
      "id": "a_counted_key_written_beside_an_index",
      "session_id": "default",
      "sql": "CREATE TABLE p0_counted_beside_index (id INT NOT NULL AUTO_INCREMENT, n INT, PRIMARY KEY (id), KEY idx_n (n)) ENGINE=InnoDB"
    },
    {
      "id": "what_the_table_beside_an_index_carries",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_counted_beside_index"
    },
    {
      "id": "cleanup_dumped",
      "session_id": "default",
      "sql": "DROP TABLE p0_counted_dumped"
    },
    {
      "id": "cleanup_beside_an_index",
      "session_id": "default",
      "sql": "DROP TABLE p0_counted_beside_index"
    }
  ]
}
