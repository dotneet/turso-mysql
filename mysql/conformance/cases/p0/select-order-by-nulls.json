{
  "version": 1,
  "id": "p0.select-order-by-nulls",
  "tags": ["p0", "select", "order-by"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_table",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_order_nulls"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "create_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_order_nulls (id INT NOT NULL PRIMARY KEY, n INT, name VARCHAR(10)) ENGINE=InnoDB"
    },
    {
      "id": "insert_rows",
      "session_id": "default",
      "sql": "INSERT INTO p0_order_nulls (id, n, name) VALUES (1, 2, 'b'), (2, NULL, NULL), (3, 1, 'a'), (4, NULL, 'c')"
    },
    {
      "id": "nulls_last",
      "session_id": "default",
      "sql": "SELECT id FROM p0_order_nulls ORDER BY n IS NULL, n"
    },
    {
      "id": "nulls_first_which_is_the_default",
      "session_id": "default",
      "sql": "SELECT id FROM p0_order_nulls ORDER BY n"
    },
    {
      "id": "nulls_last_descending",
      "session_id": "default",
      "sql": "SELECT id FROM p0_order_nulls ORDER BY n IS NULL, n DESC"
    },
    {
      "id": "nulls_first_written_out",
      "session_id": "default",
      "sql": "SELECT id FROM p0_order_nulls ORDER BY n IS NOT NULL, n"
    },
    {
      "id": "nulls_last_on_a_word",
      "session_id": "default",
      "sql": "SELECT id FROM p0_order_nulls ORDER BY name IS NULL, name"
    },
    {
      "id": "the_flag_on_its_own_descending",
      "session_id": "default",
      "sql": "SELECT id FROM p0_order_nulls ORDER BY n IS NULL DESC, id"
    },
    {
      "id": "cleanup_table",
      "session_id": "default",
      "sql": "DROP TABLE p0_order_nulls"
    }
  ]
}
