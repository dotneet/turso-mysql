{
  "version": 1,
  "id": "p0.truncate-counted-table",
  "tags": ["p0", "dml", "auto-increment"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_counted",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_emptied"
    },
    {
      "id": "drop_child",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_emptied_child"
    },
    {
      "id": "drop_parent",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_emptied_parent"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "a_counted_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_emptied (id INT NOT NULL AUTO_INCREMENT, n INT, PRIMARY KEY (id), KEY by_n (n)) ENGINE=InnoDB"
    },
    {
      "id": "rows_that_move_the_counter",
      "session_id": "default",
      "sql": "INSERT INTO p0_emptied (n) VALUES (1), (2)"
    },
    {
      "id": "the_counter_before",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_emptied"
    },
    {
      "id": "emptying_it",
      "session_id": "default",
      "sql": "TRUNCATE TABLE p0_emptied"
    },
    {
      "id": "what_it_holds_after",
      "session_id": "default",
      "sql": "SELECT COUNT(*) FROM p0_emptied"
    },
    {
      "id": "the_counter_after",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_emptied"
    },
    {
      "id": "the_indexes_after",
      "session_id": "default",
      "sql": "SELECT INDEX_NAME, COLUMN_NAME FROM information_schema.STATISTICS WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'p0_emptied' ORDER BY INDEX_NAME, SEQ_IN_INDEX"
    },
    {
      "id": "the_next_row",
      "session_id": "default",
      "sql": "INSERT INTO p0_emptied (n) VALUES (9)"
    },
    {
      "id": "the_id_it_took",
      "session_id": "default",
      "sql": "SELECT id, n FROM p0_emptied ORDER BY id"
    },
    {
      "id": "a_parent_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_emptied_parent (id INT NOT NULL, PRIMARY KEY (id)) ENGINE=InnoDB"
    },
    {
      "id": "a_child_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_emptied_child (id INT NOT NULL, owner INT, PRIMARY KEY (id), CONSTRAINT p0_emptied_fk FOREIGN KEY (owner) REFERENCES p0_emptied_parent (id)) ENGINE=InnoDB"
    },
    {
      "id": "emptying_a_table_a_foreign_key_names",
      "session_id": "default",
      "sql": "TRUNCATE TABLE p0_emptied_parent"
    },
    {
      "id": "cleanup_counted",
      "session_id": "default",
      "sql": "DROP TABLE p0_emptied"
    },
    {
      "id": "cleanup_child",
      "session_id": "default",
      "sql": "DROP TABLE p0_emptied_child"
    },
    {
      "id": "cleanup_parent",
      "session_id": "default",
      "sql": "DROP TABLE p0_emptied_parent"
    }
  ]
}
