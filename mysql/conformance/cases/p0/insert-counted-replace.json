{
  "version": 1,
  "id": "p0.insert-counted-replace",
  "tags": ["p0", "dml", "auto-increment"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_counted",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_counted_replace"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "a_counted_table_with_a_unique_column",
      "session_id": "default",
      "sql": "CREATE TABLE p0_counted_replace (id INT NOT NULL AUTO_INCREMENT, email VARCHAR(40) NOT NULL, n INT, PRIMARY KEY (id), UNIQUE KEY uq_p0_replace (email)) ENGINE=InnoDB"
    },
    {
      "id": "a_first_row",
      "session_id": "default",
      "sql": "INSERT INTO p0_counted_replace (email, n) VALUES ('a@x.test', 1)"
    },
    {
      "id": "an_ignored_row_that_collides",
      "session_id": "default",
      "sql": "INSERT IGNORE INTO p0_counted_replace (email, n) VALUES ('a@x.test', 2)"
    },
    {
      "id": "what_the_counter_stands_at_after_the_skip",
      "session_id": "default",
      "sql": "SELECT LAST_INSERT_ID()"
    },
    {
      "id": "the_table_after_the_skip",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_counted_replace"
    },
    {
      "id": "an_ignored_row_that_does_not_collide",
      "session_id": "default",
      "sql": "INSERT IGNORE INTO p0_counted_replace (email, n) VALUES ('b@x.test', 3)"
    },
    {
      "id": "a_replace_that_collides",
      "session_id": "default",
      "sql": "REPLACE INTO p0_counted_replace (email, n) VALUES ('a@x.test', 4)"
    },
    {
      "id": "a_replace_that_does_not_collide",
      "session_id": "default",
      "sql": "REPLACE INTO p0_counted_replace (email, n) VALUES ('c@x.test', 5)"
    },
    {
      "id": "the_rows_at_the_end",
      "session_id": "default",
      "sql": "SELECT id, email, n FROM p0_counted_replace ORDER BY id"
    },
    {
      "id": "the_counter_at_the_end",
      "session_id": "default",
      "sql": "SHOW CREATE TABLE p0_counted_replace"
    },
    {
      "id": "cleanup_counted",
      "session_id": "default",
      "sql": "DROP TABLE p0_counted_replace"
    }
  ]
}
