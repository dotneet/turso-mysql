{
  "version": 1,
  "id": "p0.select-moment-argument",
  "tags": ["p0", "select", "date", "function"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_table",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_moment"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "create_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_moment (id INT NOT NULL PRIMARY KEY, m DATETIME, w VARCHAR(30)) ENGINE=InnoDB"
    },
    {
      "id": "insert_rows",
      "session_id": "default",
      "sql": "INSERT INTO p0_moment (id, m, w) VALUES (1, '2024-03-05 10:20:30', '2024-03-05')"
    },
    {
      "id": "a_moment_written_out_from_a_column",
      "session_id": "default",
      "sql": "SELECT DATE_FORMAT(m, '%Y-%m-%d') FROM p0_moment"
    },
    {
      "id": "a_moment_written_out_from_a_word",
      "session_id": "default",
      "sql": "SELECT DATE_FORMAT('2024-03-05', '%Y-%m-%d')"
    },
    {
      "id": "a_day_read_from_a_column",
      "session_id": "default",
      "sql": "SELECT STR_TO_DATE(w, '%Y-%m-%d') FROM p0_moment"
    },
    {
      "id": "a_day_read_from_a_word",
      "session_id": "default",
      "sql": "SELECT STR_TO_DATE('2024-03-05', '%Y-%m-%d')"
    },
    {
      "id": "a_clock_reading_read_from_a_word",
      "session_id": "default",
      "sql": "SELECT STR_TO_DATE('10:20:30', '%H:%i:%s')"
    },
    {
      "id": "a_moment_read_from_a_word",
      "session_id": "default",
      "sql": "SELECT STR_TO_DATE('2024-03-05 10:20:30', '%Y-%m-%d %H:%i:%s')"
    },
    {
      "id": "cleanup_table",
      "session_id": "default",
      "sql": "DROP TABLE p0_moment"
    }
  ]
}
