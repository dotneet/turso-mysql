    {
      "id": "the_same_mode_named_by_its_scope",
      "session_id": "default",
      "sql": "SELECT @@session.sql_mode"
    },
    {
      "id": "the_mode_under_an_alias",
      "session_id": "default",
      "sql": "SELECT @@sql_mode AS m"
    },
    {
      "id": "whether_each_statement_commits",
      "session_id": "default",
      "sql": "SELECT @@autocommit"
    },
    {
      "id": "whether_notes_are_raised",
      "session_id": "default",
      "sql": "SELECT @@sql_notes"
    }
