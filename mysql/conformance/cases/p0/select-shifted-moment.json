{
  "version": 1,
  "id": "p0.select-shifted-moment",
  "tags": [
    "p0",
    "select",
    "temporal"
  ],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {
        "kind": "utc"
      },
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_table",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_shifted_moment"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "create_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_shifted_moment (id INT NOT NULL PRIMARY KEY, d DATE, dt DATETIME) ENGINE=InnoDB"
    },
    {
      "id": "insert_rows",
      "session_id": "default",
      "sql": "INSERT INTO p0_shifted_moment (id, d, dt) VALUES (1, CURDATE(), NOW()), (2, DATE_SUB(CURDATE(), INTERVAL 10 DAY), DATE_SUB(NOW(), INTERVAL 10 DAY)), (3, '2000-01-01', '2000-01-01 00:00:00')"
    },
    {
      "id": "rows_within_the_last_month",
      "session_id": "default",
      "sql": "SELECT id FROM p0_shifted_moment WHERE dt > DATE_SUB(NOW(), INTERVAL 30 DAY) ORDER BY id"
    },
    {
      "id": "rows_within_the_last_week",
      "session_id": "default",
      "sql": "SELECT id FROM p0_shifted_moment WHERE dt > DATE_SUB(NOW(), INTERVAL 7 DAY) ORDER BY id"
    },
    {
      "id": "days_within_the_last_month",
      "session_id": "default",
      "sql": "SELECT id FROM p0_shifted_moment WHERE d >= DATE_SUB(CURDATE(), INTERVAL 30 DAY) ORDER BY id"
    },
    {
      "id": "days_a_month_from_now",
      "session_id": "default",
      "sql": "SELECT id FROM p0_shifted_moment WHERE d < DATE_ADD(CURDATE(), INTERVAL 1 MONTH) ORDER BY id"
    },
    {
      "id": "cleanup_table",
      "session_id": "default",
      "sql": "DROP TABLE p0_shifted_moment"
    }
  ]
}
