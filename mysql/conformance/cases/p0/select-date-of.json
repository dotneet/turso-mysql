{
  "version": 1,
  "id": "p0.select-date-of",
  "tags": ["p0", "select", "temporal"],
  "sessions": [
    {
      "id": "default",
      "sql_mode": {
        "flags": [
          "only_full_group_by",
          "strict_trans_tables",
          "no_zero_in_date",
          "no_zero_date",
          "error_for_division_by_zero",
          "no_engine_substitution"
        ]
      },
      "time_zone": {"kind": "utc"},
      "isolation": "repeatable_read",
      "autocommit": true
    }
  ],
  "steps": [
    {
      "id": "disable_notes_for_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 0"
    },
    {
      "id": "drop_table",
      "session_id": "default",
      "sql": "DROP TABLE IF EXISTS p0_date_of"
    },
    {
      "id": "restore_notes_after_cleanup",
      "session_id": "default",
      "sql": "SET SESSION sql_notes = 1"
    },
    {
      "id": "create_table",
      "session_id": "default",
      "sql": "CREATE TABLE p0_date_of (id INT NOT NULL PRIMARY KEY, dt DATETIME, d DATE, ts TIMESTAMP NULL) ENGINE=InnoDB"
    },
    {
      "id": "insert_rows",
      "session_id": "default",
      "sql": "INSERT INTO p0_date_of (id, dt, d, ts) VALUES (1, '2024-06-15 12:30:45', '2024-06-15', '2024-06-15 12:30:45'), (2, '2024-06-15 00:00:00', '2000-01-01', '2000-01-01 00:00:00'), (3, '2000-01-01 23:59:59', NULL, NULL)"
    },
    {
      "id": "the_day_out_of_each_kind",
      "session_id": "default",
      "sql": "SELECT DATE(dt), DATE(d), DATE(ts) FROM p0_date_of ORDER BY id"
    },
    {
      "id": "rows_on_one_day",
      "session_id": "default",
      "sql": "SELECT id FROM p0_date_of WHERE DATE(dt) = '2024-06-15' ORDER BY id"
    },
    {
      "id": "rows_before_a_day",
      "session_id": "default",
      "sql": "SELECT id FROM p0_date_of WHERE DATE(dt) < '2024-01-01' ORDER BY id"
    },
    {
      "id": "the_day_of_a_day_is_the_day",
      "session_id": "default",
      "sql": "SELECT id FROM p0_date_of WHERE DATE(d) = '2000-01-01' ORDER BY id"
    },
    {
      "id": "cleanup_table",
      "session_id": "default",
      "sql": "DROP TABLE p0_date_of"
    }
  ]
}
