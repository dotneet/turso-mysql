          {
            "type": "text",
            "value": "CREATE TABLE `d_child` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `parent_id` bigint unsigned DEFAULT NULL,\n  `name` varchar(64) NOT NULL,\n  `amount` decimal(10,2) NOT NULL,\n  `normalized` varchar(64) GENERATED ALWAYS AS (lower(`name`)) STORED,\n  `created_at` timestamp(6) NULL DEFAULT CURRENT_TIMESTAMP(6) ON UPDATE CURRENT_TIMESTAMP(6),\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_child_name` (`name`),\n  KEY `idx_child_parent` (`parent_id`),\n  CONSTRAINT `fk_child_parent` FOREIGN KEY (`parent_id`) REFERENCES `d_parent` (`id`) ON DELETE CASCADE ON UPDATE RESTRICT,\n  CONSTRAINT `chk_child_amount` CHECK ((`amount` >= 0))\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci"
          }
        ]
