+#[test]
+fn explicit_insert_columns_report_missing_required_defaults() {
+    let connection = connection();
+    connection
+        .execute("CREATE TABLE required_values (required INT NOT NULL, optional INT DEFAULT 7)")
+        .unwrap();
+
+    let error = connection
+        .execute_checked_write("INSERT INTO required_values (optional) VALUES (2)", None)
+        .unwrap_err();
+    assert!(
+        matches!(
+            error,
+            turso_mysql::MySqlQueryError::MissingRequiredDefault(ref column)
+                if column == "required"
+        ),
+        "{error}"
+    );
+
+    let prepared = connection
+        .prepare_checked_statement("INSERT INTO required_values (optional) VALUES (?)")
+        .unwrap();
+    let error = connection
+        .execute_prepared_statement(
+            prepared.statement_id,
+            &[turso_mysql::MySqlPreparedValue::Integer(2)],
+            None,
+            MySqlAffectedRowsMode::Changed,
+        )
+        .unwrap_err();
+    assert!(
+        matches!(
+            error,
+            turso_mysql::MySqlPreparedStatementError::MissingRequiredDefault(ref column)
+                if column == "required"
+        ),
+        "{error}"
+    );
+    connection.close().unwrap();
+}
+
