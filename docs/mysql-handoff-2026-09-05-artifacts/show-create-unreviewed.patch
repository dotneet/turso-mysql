+/// The result of reconstructing one persisted base-table definition.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct MySqlShowCreateTableResult {
+    table_name: String,
+    create_statement: String,
+}
+
+impl MySqlShowCreateTableResult {
+    /// Returns the table name as stored in the trusted schema catalog.
+    pub fn table_name(&self) -> &str {
+        &self.table_name
+    }
+
+    /// Returns the canonical MySQL `CREATE TABLE` statement.
+    pub fn create_statement(&self) -> &str {
+        &self.create_statement
+    }
+}
+
+/// Failure while reconstructing one persisted base-table definition.
+#[derive(Debug)]
+pub enum MySqlShowCreateTableError {
+    /// The selected database has no user table with this name.
+    TableNotFound,
+    /// The named object is a view rather than a base table.
+    NotTable,
+    /// The persisted DDL is valid but outside the supported SHOW surface.
+    UnsupportedDefinition,
+    /// The persisted schema row violates a durable MySQL schema invariant.
+    CorruptDefinition,
+    /// Core could not read the trusted schema catalog.
+    Engine(LimboError),
+}
+
+impl fmt::Display for MySqlShowCreateTableError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::TableNotFound => f.write_str("MySQL table was not found"),
+            Self::NotTable => f.write_str("MySQL object is not a base table"),
+            Self::UnsupportedDefinition => {
+                f.write_str("MySQL table definition is not supported by SHOW CREATE TABLE")
+            }
+            Self::CorruptDefinition => f.write_str("MySQL table definition is corrupt"),
+            Self::Engine(error) => error.fmt(f),
+        }
+    }
+}
+
+impl Error for MySqlShowCreateTableError {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::Engine(error) => Some(error),
+            Self::TableNotFound
+            | Self::NotTable
+            | Self::UnsupportedDefinition
+            | Self::CorruptDefinition => None,
+        }
+    }
+}
