+    /// Reconstructs the canonical MySQL definition of one persisted base table.
+    ///
+    /// The marker payload is never exposed directly. Column reconstruction
+    /// first verifies the trusted Core catalog and the durable MySQL metadata;
+    /// canonical parsing then proves that the returned statement is one of the
+    /// supported table definitions.
+    pub fn show_create_table(
+        &self,
+        table: &MySqlTableName,
+    ) -> std::result::Result<MySqlShowCreateTableResult, MySqlShowCreateTableError> {
+        if turso_core::schema::is_system_table(table.as_str()) {
+            return Err(MySqlShowCreateTableError::TableNotFound);
+        }
+        let sql = format!(
+            "SELECT name, type, sql FROM sqlite_schema \
+             WHERE type IN ('table', 'view') AND lower(name) = '{table_name}' LIMIT 2",
+            table_name = table.as_str()
+        );
+        let rows = self
+            .inner
+            .prepare_internal(&sql)
+            .map_err(MySqlShowCreateTableError::Engine)?
+            .run_collect_rows()
+            .map_err(MySqlShowCreateTableError::Engine)?;
+        let row = match rows.as_slice() {
+            [] => return Err(MySqlShowCreateTableError::TableNotFound),
+            [row] => row,
+            _ => return Err(MySqlShowCreateTableError::CorruptDefinition),
+        };
+        let [catalog_name, object_type, stored_sql] = row.as_slice() else {
+            return Err(MySqlShowCreateTableError::CorruptDefinition);
+        };
+        let catalog_name = catalog_name
+            .to_text()
+            .ok_or(MySqlShowCreateTableError::CorruptDefinition)?;
+        let object_type = object_type
+            .to_text()
+            .ok_or(MySqlShowCreateTableError::CorruptDefinition)?;
+        let stored_sql = stored_sql
+            .to_text()
+            .ok_or(MySqlShowCreateTableError::CorruptDefinition)?;
+        if !catalog_name.eq_ignore_ascii_case(table.as_str()) {
+            return Err(MySqlShowCreateTableError::CorruptDefinition);
+        }
+        if object_type.eq_ignore_ascii_case("view") {
+            return Err(MySqlShowCreateTableError::NotTable);
+        }
+        if !object_type.eq_ignore_ascii_case("table") {
+            return Err(MySqlShowCreateTableError::CorruptDefinition);
+        }
+
+        self.list_columns(table).map_err(|error| match error {
+            MySqlColumnMetadataError::TableNotFound => MySqlShowCreateTableError::TableNotFound,
+            MySqlColumnMetadataError::UnsupportedDefinition => {
+                MySqlShowCreateTableError::UnsupportedDefinition
+            }
+            MySqlColumnMetadataError::CorruptDefinition => {
+                MySqlShowCreateTableError::CorruptDefinition
+            }
+            MySqlColumnMetadataError::Engine(error) => MySqlShowCreateTableError::Engine(error),
+        })?;
+        let create_statement = canonical_show_create_table_ddl(stored_sql)?;
+        Ok(MySqlShowCreateTableResult {
+            table_name: catalog_name.to_owned(),
+            create_statement,
+        })
+    }
