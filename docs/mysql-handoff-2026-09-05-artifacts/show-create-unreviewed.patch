+fn show_create_table_error_kind(error: MySqlShowCreateTableError) -> FrontendErrorKind {
+    match error {
+        MySqlShowCreateTableError::TableNotFound => FrontendErrorKind::MissingObject,
+        MySqlShowCreateTableError::NotTable | MySqlShowCreateTableError::UnsupportedDefinition => {
+            FrontendErrorKind::Unsupported
+        }
+        MySqlShowCreateTableError::CorruptDefinition | MySqlShowCreateTableError::Engine(_) => {
+            FrontendErrorKind::Internal
+        }
+    }
+}
