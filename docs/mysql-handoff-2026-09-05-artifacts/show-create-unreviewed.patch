+fn canonical_show_create_table_ddl(
+    stored_sql: &str,
+) -> std::result::Result<String, MySqlShowCreateTableError> {
+    let decoded = decode_schema_sql(SchemaSqlKind::Table, stored_sql)
+        .map_err(|_| MySqlShowCreateTableError::CorruptDefinition)?
+        .ok_or(MySqlShowCreateTableError::UnsupportedDefinition)?;
+    let mode = SessionSqlMode {
+        ansi_quotes: decoded.context.sql_mode.ansi_quotes,
+        no_backslash_escapes: decoded.context.sql_mode.no_backslash_escapes,
+    };
+    let canonical = if decoded.v2_metadata().is_some() {
+        parse_auto_increment_create_table(decoded.normalized_ddl, mode)
+            .map(|checked| checked.normalized_mysql_ddl)
+            .map_err(|_| MySqlShowCreateTableError::CorruptDefinition)?
+    } else {
+        match parse_checked_primary_key_create_table(decoded.normalized_ddl, mode) {
+            Ok(checked) => checked.normalized_mysql_ddl,
+            Err(_) => {
+                let statement =
+                    parse_create_table_ast(decoded.normalized_ddl, mode).map_err(|error| {
+                        match error {
+                            MySqlParseError::Unsupported { .. } => {
+                                MySqlShowCreateTableError::UnsupportedDefinition
+                            }
+                            _ => MySqlShowCreateTableError::CorruptDefinition,
+                        }
+                    })?;
+                render_create_table_mysql_with_mode(&statement, mode).map_err(
+                    |error| match error {
+                        MySqlParseError::Unsupported { .. } => {
+                            MySqlShowCreateTableError::UnsupportedDefinition
+                        }
+                        _ => MySqlShowCreateTableError::CorruptDefinition,
+                    },
+                )?
+            }
+        }
+    };
+    if canonical != decoded.normalized_ddl {
+        return Err(MySqlShowCreateTableError::CorruptDefinition);
+    }
+    Ok(canonical)
+}
