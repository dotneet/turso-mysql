+fn information_schema_schemata_column() -> ColumnDefinitionConfig {
+    let mut column = ColumnDefinitionConfig::new("SCHEMA_NAME", MYSQL_TYPE_VAR_STRING);
+    "information_schema".clone_into(&mut column.schema);
