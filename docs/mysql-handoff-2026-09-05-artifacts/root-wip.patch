+/// Parses the strict `information_schema.SCHEMATA` catalog query.
+pub fn parse_information_schema_schemata(
+    sql: &str,
+    mode: SessionSqlMode,
+) -> Result<MySqlInformationSchemaSchemataQuery, ParseError> {
