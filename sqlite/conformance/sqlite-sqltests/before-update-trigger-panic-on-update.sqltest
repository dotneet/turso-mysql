@database :memory:

test before-update-trigger-panic-on-update {
    CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT);
    CREATE TRIGGER tr BEFORE UPDATE ON t BEGIN SELECT 1; END;
    UPDATE t SET v='b' WHERE '';
    SELECT count(*) FROM t;
}

expect {
    0
}

test before-update-trigger-not-null-rowid-alias-takes-a-new-key {
    CREATE TABLE t(id INTEGER NOT NULL PRIMARY KEY, n INTEGER);
    INSERT INTO t VALUES (1, 1);
    CREATE TRIGGER tr BEFORE UPDATE ON t BEGIN SELECT 1; END;
    UPDATE t SET id = 7 WHERE id = 1;
    SELECT id, n FROM t;
}

expect {
    7|1
}
